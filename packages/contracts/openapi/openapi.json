    "/api/v1/reviews/{review_id}": {"get": {"x-tenant-scoped": true, "responses": {"200": {"description": "Review", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PersistedReview"}}}}, "404": {"$ref": "#/components/responses/Error"}}}},
