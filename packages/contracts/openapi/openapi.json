  },
  "components": {
    "securitySchemes": {"HostSession": {"type": "apiKey", "in": "cookie", "name": "__Host-swb_session", "x-host-only": true, "x-secure": true, "x-http-only": true, "x-same-site": "Lax"}},
    "parameters": {
      "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 1}},
      "IfMatch": {"name": "If-Match", "in": "header", "required": true, "schema": {"type": "string", "pattern": "^(?:[0-9]+|\\\"[0-9]+\\\")$"}},
      "LastEventId": {"name": "Last-Event-ID", "in": "header", "required": false, "schema": {"type": "integer", "minimum": 0}},
      "ProjectId": {"name": "project_id", "in": "path", "required": true, "schema": {"$ref": "#/components/schemas/Uuid7"}},
      "SessionId": {"name": "session_id", "in": "path", "required": true, "schema": {"$ref": "#/components/schemas/Uuid7"}}
    },
    "responses": {"Error": {"description": "Canonical error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}}},
    "requestBodies": {
      "ProjectCreate": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProjectCreate"}}}},
      "RunCreate": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunCreate"}}}},
      "ApprovalCreate": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApprovalCreate"}}}},
      "ReviewCreate": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReviewCreate"}}}},
      "ProviderConnectionInitiate": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProviderConnectionInitiate"}}}},
      "ProviderOAuthComplete": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProviderOAuthComplete"}}}},
      "ProviderOAuthCancel": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProviderOAuthCancel"}}}},
      "ProviderModelSelect": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProviderModelSelect"}}}}
    },
    "schemas": {
      "Uuid7": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
      "UtcTimestamp": {"type": "string", "format": "date-time", "pattern": "Z$", "x-utc-only": true},
      "ErrorEnvelope": {"type": "object", "additionalProperties": false, "required": ["error"], "properties": {"error": {"type": "object", "additionalProperties": false, "required": ["code", "message", "request_id"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "request_id": {"$ref": "#/components/schemas/Uuid7"}}}}},
      "AuthContext": {"type": "object", "additionalProperties": false, "required": ["user_id", "org_id", "email", "role", "csrf_token", "expires_at"], "properties": {"user_id": {"$ref": "#/components/schemas/Uuid7"}, "org_id": {"$ref": "#/components/schemas/Uuid7", "readOnly": true}, "email": {"type": "string", "format": "email"}, "role": {"enum": ["owner", "member"]}, "csrf_token": {"type": "string"}, "expires_at": {"$ref": "#/components/schemas/UtcTimestamp"}}},
      "Organization": {"type": "object", "additionalProperties": false, "required": ["id", "name", "created_at"], "properties": {"id": {"$ref": "#/components/schemas/Uuid7"}, "name": {"type": "string"}, "created_at": {"$ref": "#/components/schemas/UtcTimestamp"}}},
      "ProjectCreate": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}},
      "Project": {"type": "object", "additionalProperties": false, "required": ["id", "org_id", "name", "revision", "created_at"], "properties": {"id": {"$ref": "#/components/schemas/Uuid7"}, "org_id": {"$ref": "#/components/schemas/Uuid7", "readOnly": true}, "name": {"type": "string"}, "revision": {"type": "integer", "minimum": 1}, "created_at": {"$ref": "#/components/schemas/UtcTimestamp"}}},
      "Session": {"type": "object", "additionalProperties": false, "required": ["id", "org_id", "project_id", "title", "revision", "created_at"], "properties": {"id": {"$ref": "#/components/schemas/Uuid7"}, "org_id": {"$ref": "#/components/schemas/Uuid7", "readOnly": true}, "project_id": {"$ref": "#/components/schemas/Uuid7"}, "title": {"type": "string"}, "revision": {"type": "integer"}, "created_at": {"$ref": "#/components/schemas/UtcTimestamp"}}},
      "Upload": {"type": "object", "additionalProperties": false, "required": ["id", "org_id", "project_id", "filename", "status", "created_at"], "properties": {"id": {"$ref": "#/components/schemas/Uuid7"}, "org_id": {"$ref": "#/components/schemas/Uuid7", "readOnly": true}, "project_id": {"$ref": "#/components/schemas/Uuid7"}, "filename": {"type": "string"}, "status": {"enum": ["pending", "clean", "rejected"]}, "created_at": {"$ref": "#/components/schemas/UtcTimestamp"}}},
      "RunCreate": {"type": "object", "additionalProperties": false, "required": ["session_id", "provider_connection_id", "prompt"], "properties": {"session_id": {"$ref": "#/components/schemas/Uuid7"}, "provider_connection_id": {"$ref": "#/components/schemas/Uuid7"}, "prompt": {"type": "string", "minLength": 1}}},
      "Run": {"type": "object", "additionalProperties": false, "required": ["id", "org_id", "session_id", "provider_connection_id", "status", "created_at", "updated_at"], "properties": {"id": {"$ref": "#/components/schemas/Uuid7"}, "org_id": {"$ref": "#/components/schemas/Uuid7", "readOnly": true}, "session_id": {"$ref": "#/components/schemas/Uuid7"}, "provider_connection_id": {"$ref": "#/components/schemas/Uuid7"}, "retry_of_run_id": {"$ref": "#/components/schemas/Uuid7"}, "status": {"enum": ["queued", "running", "awaiting_user", "awaiting_approval", "completed", "failed", "cancelled"]}, "created_at": {"$ref": "#/components/schemas/UtcTimestamp"}, "updated_at": {"$ref": "#/components/schemas/UtcTimestamp"}}},
      "RunEvent": {"type": "object", "additionalProperties": false, "required": ["run_id", "sequence", "type", "created_at"], "properties": {"run_id": {"$ref": "#/components/schemas/Uuid7"}, "sequence": {"type": "integer", "minimum": 1}, "type": {"enum": ["run.status", "message.delta", "tool.started", "tool.output", "tool.completed", "approval.required", "artifact.saved", "review.finding", "run.completed", "run.failed"]}, "created_at": {"$ref": "#/components/schemas/UtcTimestamp"}}},
      "ApprovalCreate": {"type": "object", "additionalProperties": false, "required": ["approval_digest"], "properties": {"approval_digest": {"type": "string", "minLength": 32}}},
      "Artifact": {"type": "object", "additionalProperties": false, "required": ["id", "org_id", "project_id", "name", "created_at"], "properties": {"id": {"$ref": "#/components/schemas/Uuid7"}, "org_id": {"$ref": "#/components/schemas/Uuid7", "readOnly": true}, "project_id": {"$ref": "#/components/schemas/Uuid7"}, "name": {"type": "string"}, "created_at": {"$ref": "#/components/schemas/UtcTimestamp"}}},
