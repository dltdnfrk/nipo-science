    "/api/v1/provider-connections": {"get": {"x-tenant-scoped": true, "x-capability-forbidden": true, "responses": {"200": {"description": "Requester connections", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProviderConnectionList"}}}}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}, "post": {"x-tenant-scoped": true, "x-capability-forbidden": true, "x-mutation-protection": true, "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/ProviderConnectionInitiate"}, "responses": {"202": {"description": "Connection initiated", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProviderInitiation"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/provider-connections/registry": {"get": {"x-tenant-scoped": true, "x-capability-forbidden": true, "responses": {"200": {"description": "Provider registry", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProviderRegistry"}}}}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/provider-connections/oauth/complete": {"post": {"x-tenant-scoped": true, "x-capability-forbidden": true, "x-mutation-protection": true, "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/ProviderOAuthComplete"}, "responses": {"200": {"description": "Connection completed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProviderConnection"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/provider-connections/oauth/cancel": {"post": {"x-tenant-scoped": true, "x-capability-forbidden": true, "x-mutation-protection": true, "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/ProviderOAuthCancel"}, "responses": {"200": {"description": "Authorization cancelled", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProviderOAuthCancellation"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/provider-connections/{connection_id}": {"get": {"x-tenant-scoped": true, "x-capability-forbidden": true, "responses": {"200": {"description": "Connection", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProviderConnection"}}}}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}, "delete": {"x-tenant-scoped": true, "x-capability-forbidden": true, "x-mutation-protection": true, "parameters": [{"$ref": "#/components/parameters/IfMatch"}], "responses": {"200": {"description": "Revocation accepted", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProviderRevokeAccepted"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "412": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/provider-connections/{connection_id}/model": {"post": {"x-tenant-scoped": true, "x-capability-forbidden": true, "x-mutation-protection": true, "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}, {"$ref": "#/components/parameters/IfMatch"}], "requestBody": {"$ref": "#/components/requestBodies/ProviderModelSelect"}, "responses": {"200": {"description": "Model selected", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProviderConnection"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "412": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/provider-connections/{connection_id}/health": {"post": {"x-tenant-scoped": true, "x-capability-forbidden": true, "x-mutation-protection": true, "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}, {"$ref": "#/components/parameters/IfMatch"}], "responses": {"200": {"description": "Connection health refreshed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProviderConnection"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "412": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/provider-connections/{connection_id}/reauth": {"post": {"x-tenant-scoped": true, "x-capability-forbidden": true, "x-mutation-protection": true, "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}, {"$ref": "#/components/parameters/IfMatch"}], "responses": {"202": {"description": "Reauthorization initiated", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProviderInitiation"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "412": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/deletions": {"post": {"x-tenant-scoped": true, "x-mutation-protection": true, "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"202": {"description": "Deletion queued"}, "404": {"$ref": "#/components/responses/Error"}}}},
