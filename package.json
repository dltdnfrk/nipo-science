{
  "name": "science-workbench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": "24.17.0",
    "pnpm": "11.12.0"
  },
  "scripts": {
    "contracts:lint": "biome check packages/contracts",
    "contracts:typecheck": "tsc -p packages/contracts/tsconfig.json",
    "contracts:test": "vitest run --dir packages/contracts/tests",
    "test:e2e:artifacts": "playwright test tests/e2e/artifacts.spec.ts tests/e2e/product-accessibility.spec.ts tests/e2e/product-journey.spec.ts tests/e2e/provider-settings.spec.ts tests/e2e/provider-settings-rendering.spec.ts",
    "test:e2e:local": "playwright test -c tests/e2e/local.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.2",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
