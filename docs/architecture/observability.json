{
  "allowed_metadata": [
    "artifact_id",
    "error_code",
    "latency_ms",
    "provider_id",
    "request_id",
    "run_id",
    "status"
  ],
  "local_only": {
    "log_destination": "files-inside-the-researcher-owned-data-root",
    "external_log_shipping": "absent",
    "telemetry": "absent",
    "implicit_cloud_sync": "absent"
  },
  "prohibited_metadata": [
    "authorization",
    "cookie",
    "local_session_token",
    "provider_api_key",
    "prompt",
    "research_content"
  ]
}
