{
  "schema_version": 1,
  "system": "science-workbench",
  "decisions": [
    {"id": "isolated-monorepo-service-boundaries", "adr": "decisions/ADR-0001-isolated-monorepo.md", "status": "accepted"},
    {"id": "same-origin-auth", "adr": "decisions/ADR-0002-same-origin-auth.md", "status": "accepted"},
    {"id": "transactional-event-log", "adr": "decisions/ADR-0003-transactional-event-log.md", "status": "accepted"},
    {"id": "artifact-first-immutable-provenance", "adr": "decisions/ADR-0004-artifact-first-provenance.md", "status": "accepted"},
    {"id": "local-gke-runner-parity", "adr": "decisions/ADR-0005-runner-parity.md", "status": "accepted"},
    {"id": "opaque-per-user-runtime-homes", "adr": "decisions/ADR-0006-runtime-homes.md", "status": "accepted"},
    {"id": "application-sole-tool-executor", "adr": "decisions/ADR-0007-tool-execution.md", "status": "accepted"},
    {"id": "reviewer-non-reexecution", "adr": "decisions/ADR-0008-reviewer.md", "status": "accepted"},
    {"id": "oauth-f13-state-separation", "adr": "decisions/ADR-0009-oauth-f13-separation.md", "status": "accepted"},
    {"id": "external-provider-qualification-authority", "adr": "decisions/ADR-0010-provider-qualification-authority.md", "status": "accepted"},
    {"id": "local-first-single-user", "adr": "decisions/ADR-0011-local-first-single-user.md", "status": "accepted"}
  ],
  "trust_boundaries": [
    {"id": "local-web-to-loopback-api", "owner": "local-platform", "source": "apps-web-local", "target": "nipo-local-loopback-api", "data": ["commands", "queries", "local_session_credential"]},
    {"id": "loopback-api-to-local-data-root", "owner": "local-platform", "source": "nipo-local-loopback-api", "target": "researcher-owned-data-root", "data": ["artifact_versions", "run_records", "exports", "settings"]},
    {"id": "loopback-api-to-provider-endpoint", "owner": "provider-security", "source": "nipo-local-loopback-api", "target": "researcher-owned-provider-endpoint", "data": ["prompts", "model_responses"]},
    {"id": "workbench-to-in-process-analysis", "owner": "local-platform", "source": "nipo-local-workbench", "target": "in-process-deterministic-python", "data": ["pinned_inputs", "research_intent", "analysis_outputs"]},
    {"id": "credential-registry-to-keychain", "owner": "credential-security", "source": "provider-credential-registry", "target": "macos-keychain-master-key", "data": ["master_key_generic_password"]},
    {"id": "reviewer-to-read-model", "owner": "review-platform", "source": "reviewer", "target": "immutable-read-model", "data": ["pinned_versions", "executions", "sources"]},
    {"id": "export-builder-to-export-directory", "owner": "artifact-platform", "source": "export-pack-builder", "target": "owner-only-export-directory", "data": ["pinned_export_pack"]}
  ],
  "contracts": {
    "local_store": {"engine": "sqlite-wal", "atomic_with_state_change": true, "ordering": "per-run-monotonic-state-machine", "authorization_source": "operating-system-account-owning-the-data-root"},
    "artifact_provenance": {"versions_immutable": true, "required_hashes": ["content", "code", "environment", "inputs", "execution", "research_intent"]},
    "execution": {"language": "deterministic-python", "isolation_level": "in_process", "isolation_reporting": "recorded-value-verbatim-never-a-default", "sandbox_claims": "forbidden-without-an-outcome-test-of-the-specific-denial"},
    "provider_credentials": {"plaintext_at_rest": false, "cipher": "aes-256-gcm", "additional_authenticated_data": "provider_id", "master_key_holder": "macos-keychain-generic-password", "automatic_fallback": false, "egress": "explicitly-selected-provider-only"},
    "tool_execution": {"executor": "application", "model_role": "typed-action-proposal-only", "model_output_promotion": "never-without-application-policy"},
    "reviewer": {
      "allowed_capabilities": [
        "read_pinned_evidence",
        "submit_findings_once"
      ],
      "forbidden_capabilities": ["runner", "python", "bash", "connector", "network", "tool_execute", "artifact_write", "version_update"],
      "reexecution": false
    },
    "local_interface": {"listener": "loopback-only", "non_loopback_bind": "refused", "remote_access_toggle": "absent"}
  },
  "claims": {
    "in_process_execution_provides_confinement": false,
    "keychain_item_restricted_to_this_application": false,
    "isolation_acceptance": "disclosed-in-process-with-outcome-tested-denials-only"
  }
}
